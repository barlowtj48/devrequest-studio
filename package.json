{
  "name": "devrequest-studio",
  "publisher": "thomas-barlow",
  "displayName": "DevRequest Studio",
  "icon": "icons/Icon.png",
  "description": "A community API testing tool for VS Code focused on fast request iteration, reusable collections, and practical request export/snippets",
  "version": "1.4.6",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/barlowtj48/devrequest-studio/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/barlowtj48/devrequest-studio"
  },
  "engines": {
    "vscode": "^1.56.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "api-client",
    "postman",
    "REST",
    "graphql",
    "http"
  ],
  "activationEvents": [
    "onCommand:devrequest.createRequest"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "devrequest.createRequest",
        "title": "DevRequest Studio: Create Request",
        "icon": "$(add)"
      },
      {
        "command": "devrequest.saveRequest",
        "title": "Save Request"
      },
      {
        "command": "devrequest.loadRequest",
        "title": "Load Request"
      },
      {
        "command": "devrequest.createCollection",
        "title": "Create Collection",
        "icon": "$(new-folder)"
      },
      {
        "command": "devrequest.deleteCollection",
        "title": "Delete Collection",
        "icon": "$(trash)"
      },
      {
        "command": "devrequest.deleteRequest",
        "title": "Delete Request",
        "icon": "$(trash)"
      },
      {
        "command": "devrequest.renameItem",
        "title": "Rename",
        "icon": "$(edit)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devrequest",
          "title": "DevRequest Studio",
          "icon": "webview/icons/package.svg"
        }
      ]
    },
    "views": {
      "devrequest": [
        {
          "id": "devrequest.collections",
          "name": "Collections"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "devrequest.collections",
        "contents": "[Create Request](command:devrequest.createRequest)\n\n[Create Collection](command:devrequest.createCollection)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "devrequest.createRequest",
          "when": "view == devrequest.collections",
          "group": "navigation"
        },
        {
          "command": "devrequest.createCollection",
          "when": "view == devrequest.collections",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "devrequest.loadRequest",
          "when": "view == devrequest.collections && viewItem == request",
          "group": "inline"
        },
        {
          "command": "devrequest.renameItem",
          "when": "view == devrequest.collections && viewItem == request",
          "group": "context"
        },
        {
          "command": "devrequest.deleteRequest",
          "when": "view == devrequest.collections && viewItem == request",
          "group": "context"
        },
        {
          "command": "devrequest.renameItem",
          "when": "view == devrequest.collections && viewItem == collection",
          "group": "context"
        },
        {
          "command": "devrequest.deleteCollection",
          "when": "view == devrequest.collections && viewItem == collection",
          "group": "context"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "yarn run package",
    "compile": "cross-env NODE_OPTIONS=--openssl-legacy-provider NODE_ENV=development webpack --progress",
    "watch": "cross-env NODE_OPTIONS=--openssl-legacy-provider NODE_ENV=development webpack --progress --watch",
    "package": "cross-env NODE_OPTIONS=\"--openssl-legacy-provider\" NODE_ENV=production webpack --progress",
    "test-compile": "tsc -p ./",
    "test-watch": "tsc -watch -p ./",
    "pretest": "yarn run test-compile && yarn run lint",
    "lint": "eslint src webview --ext .ts,.tsx",
    "lint:fix": "eslint --fix src webview --ext .ts,.tsx",
    "test": "node ./out/test/runTest.js",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@svgr/webpack": "^5.5.0",
    "@types/glob": "^7.1.3",
    "@types/mocha": "^8.0.4",
    "@types/node": "^12.11.7",
    "@types/react": "^17.0.5",
    "@types/react-dom": "^17.0.4",
    "@types/react-redux": "^7.1.16",
    "@types/vscode": "^1.56.0",
    "@typescript-eslint/eslint-plugin": "^4.14.1",
    "@typescript-eslint/parser": "^4.14.1",
    "cross-env": "^7.0.3",
    "css-loader": "^5.2.4",
    "eslint": "^7.19.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^3.4.0",
    "eslint-plugin-react": "^7.23.2",
    "file-loader": "^6.2.0",
    "glob": "^7.1.6",
    "husky": "^7.0.1",
    "mini-css-extract-plugin": "^1.6.0",
    "mocha": "^8.2.1",
    "monaco-editor-webpack-plugin": "^3.1.0",
    "prettier": "2.3.0",
    "static-site-generator-webpack-plugin": "^3.4.2",
    "style-loader": "^2.0.0",
    "ts-loader": "^8.0.14",
    "typescript": "^4.1.3",
    "url-loader": "^4.1.1",
    "vscode-test": "^1.5.0",
    "webpack": "^5.19.0",
    "webpack-cli": "^4.4.0"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^1.5.1",
    "axios": "^0.21.1",
    "buffer": "^6.0.3",
    "monaco-editor": "^0.24.0",
    "path-browserify": "^1.0.1",
    "postman-code-generators": "^1.1.5",
    "postman-collection": "^3.6.11",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-icons": "^4.2.0",
    "react-json-view": "^1.21.3",
    "react-redux": "^7.2.4",
    "url": "^0.11.0"
  }
}